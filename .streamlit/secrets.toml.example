# Copy this file to secrets.toml for local testing.
# Never commit the real secrets.toml file to GitHub.
OPENAI_API_KEY = "YOUR_OPENAI_API_KEY"
OPENAI_MODEL = "gpt-6.2-sol"
APP_ACCESS_PASSWORD = "SET_A_LONG_UNIQUE_PASSWORD"

# Configure these after creating a dedicated Supabase project.
SUPABASE_URL = "https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY = "YOUR_SERVER_SIDE_SECRET_KEY"
# Older projects may use this legacy key instead:
# SUPABASE_SERVICE_ROLE_KEY = "YOUR_LEGACY_SERVICE_ROLE_KEY"
